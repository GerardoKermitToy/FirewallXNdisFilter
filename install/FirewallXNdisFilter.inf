; Optional modifying Ethernet LWF. Notify and kernel gates require armed configuration.
[Version]
Signature="$Windows NT$"
Class=NetService
ClassGUID={4D36E974-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
CatalogFile=FirewallXNdisFilter.cat
DriverVer=10/27/2026,0.3.3.0
PnpLockdown=1

[Manufacturer]
; Driver-store notify-object packages require Windows build 25341 or later.
%Provider%=Models,NTamd64.10.0...25341

[Models.NTamd64.10.0...25341]
%Description%=Install, firewallx_ndis_filter

[Install]
Characteristics=0x40000
NetCfgInstanceId="{6E76EAD1-7BCB-49C4-9547-D3E6B3488F71}"
CopyFiles=DriverFiles,NotifyFiles
AddReg=Ndi

[Install.Services]
AddService=FirewallXNdisFilter,,Service

[Service]
DisplayName=%Description%
Description=%Help%
ServiceType=1
StartType=1
ErrorControl=1
ServiceBinary=%13%\FirewallXNdisFilter.sys
LoadOrderGroup=NDIS

[Ndi]
HKR,Ndi,Service,,"FirewallXNdisFilter"
HKR,Ndi,CoServices,0x00010000,"FirewallXNdisFilter"
HKR,Ndi,HelpText,,%Help%
HKR,Ndi,FilterClass,,"custom"
HKR,Ndi,FilterType,0x00010001,2
HKR,Ndi,FilterRunType,0x00010001,2
HKR,Ndi,ClsID,,"{1CFED41E-4579-42CF-962C-2A7E04C6DBC8}"
HKR,Ndi,ComponentDll,,"%13%\FirewallXNdisFilterNotify.dll"
HKR,Ndi\Interfaces,UpperRange,,"noupper"
HKR,Ndi\Interfaces,LowerRange,,"nolower"
HKR,Ndi\Interfaces,FilterMediaTypes,,"ethernet"

[Install.Remove.Services]
DelService=FirewallXNdisFilter,0x200

[DriverFiles]
FirewallXNdisFilter.sys,,,2

[NotifyFiles]
FirewallXNdisFilterNotify.dll,,,2

[SourceDisksNames]
1=%Description%,,,

[SourceDisksFiles]
FirewallXNdisFilter.sys=1
FirewallXNdisFilterNotify.dll=1

[DestinationDirs]
DriverFiles=13
NotifyFiles=13

[Strings]
Provider="FirewallXNdisFilter Project"
Description="FirewallXNdisFilter Rust Host Adapter LWF"
Help="Rust packet verdicts for compatible Ethernet adapter bindings."
